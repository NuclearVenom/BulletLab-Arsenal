    </collision>
  </link>

  <joint name="neck_yaw" type="continuous">
    <origin xyz="0.25 0 0.31" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="neck"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="head_pitch" type="revolute">
    <origin xyz="0.008 0 0.03" rpy="0 0 0"/>
    <parent link="neck"/>
    <child link="head"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="100" velocity="100"/>
  </joint>

  <joint name="front_right_leg" type="continuous">
    <origin xyz="0.5 -0.25 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg2"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="front_left_leg" type="continuous">
    <origin xyz="0.5 0.25 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg4"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="rear_right_leg" type="continuous">
    <origin xyz="0 -0.25 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg1"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="rear_left_leg" type="continuous">
    <origin xyz="0 0.25 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg3"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="rear_right_wheel" type="continuous">
    <origin xyz="-0.025 0.1268 -0.1268" rpy="0 0 0"/>
    <parent link="leg1"/>
    <child link="wheel1"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="front_right_wheel" type="continuous">
